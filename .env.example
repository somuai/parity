# Razorpay Dashboard > Settings > API Keys > Test Mode
# Test keys start with rzp_test_ -- free, no cost at any point.
RAZORPAY_TEST_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_TEST_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Tier 2 LLM adjudicator (Phase 3) -- Groq free tier, no card required.
# Sign up at console.groq.com
#
# Two models, tiered the same way Parity tiers its matching (Tier 1 ->
# Tier 2): a fast cheap pass first, escalate to a bigger reasoning model
# only for genuinely ambiguous cases. Both must support native JSON /
# structured-output mode (constrained decoding) -- verify current support
# at console.groq.com/docs/models before relying on these two, since
# Groq's lineup changes often. Run `curl https://api.groq.com/openai/v1/models`
# with your key to see what's actually live right now.
#
# GROQ_MODEL_REASONING defaults to gpt-oss-120b -- OpenAI's own open-weight
# model (Apache 2.0), hosted free on Groq. Qwen3.6-27b is a solid
# alternative if gpt-oss-120b's availability or rate limits don't fit --
# check both against your actual held-out set before committing.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_REASONING=openai/gpt-oss-120b

# Observability (Phase 4) -- hard ceiling so a demo run can't blow past
# Groq's free-tier rate limits (~30 req/min on-demand at time of writing --
# verify current limits at console.groq.com/docs/rate-limits before tuning
# this; the Batch Processing tier is worth using for the held-out set's
# bulk eval run specifically, since it isn't bound by the same per-minute
# ceiling as the live app's interactive rerun path).
LLM_CALL_BUDGET_PER_RUN=500
TOKEN_BUDGET_PER_RUN=200000
